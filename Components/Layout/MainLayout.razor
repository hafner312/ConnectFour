@inherits LayoutComponentBase

<header class="site-header">
    <span class="site-title">🔴 Vier Gewinnt 🟡</span>
</header>

<main>
    <article class="content">
        @Body
    </article>
</main>

<footer class="site-footer">
    <div class="footer-inner">
        <div class="footer-col footer-brand">
            <span class="footer-logo">🔴 Vier Gewinnt 🟡</span>
            <p>
                Der Spieleklassiker als Web-App: Zwei Spielerinnen oder Spieler
                setzen abwechselnd Steine an einem Gerät – der Spielzustand liegt
                auf dem Server und wird live in den Browser übertragen.
            </p>
        </div>

        <div class="footer-col">
            <h3>Spielregeln</h3>
            <ul>
                <li>Raster mit 7 Spalten</li>
                <li>Steine fallen nach unten</li>
                <li>Vier in einer Reihe gewinnt</li>
                <li>Waagrecht, senkrecht, diagonal</li>
            </ul>
        </div>

        <div class="footer-col">
            <h3>Technologie</h3>
            <ul>
                <li>C# und .NET</li>
                <li>Blazor Server</li>
                <li>SignalR</li>
                <li>Serverseitige Spiellogik</li>
            </ul>
        </div>

        <div class="footer-col">
            <h3>Mehr von mir</h3>
            <ul>
                <li>
                    <a href="https://hafner312.github.io/BewerbungsPortfolio/" target="_blank" rel="noopener">
                        Portfolio-Website
                    </a>
                </li>
                <li>
                    <a href="https://github.com/hafner312/ConnectFour" target="_blank" rel="noopener">
                        Quellcode auf GitHub
                    </a>
                </li>
                <li><a href="mailto:hafner312@gmail.com">hafner312@gmail.com</a></li>
            </ul>
        </div>
    </div>

    <div class="footer-bottom">
        <span>&copy; @DateTime.Now.Year Patrik Hafner</span>
        <span class="footer-note">
            Demo-Projekt – jede Besucherin und jeder Besucher spielt eine eigene Partie.
        </span>
    </div>
</footer>

<div id="blazor-error-ui">
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="" class="reload">Neu laden</a>
    <a class="dismiss">🗙</a>
</div>
